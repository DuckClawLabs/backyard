# ── Backyard environment variables ──────────────────────────────────────────
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── API keys (optional) ───────────────────────────────────────────────────────
# Leave empty to disable auth. Engineer identity comes from .backyard-mcp/me.yaml,
# which is sufficient when the server is on a private network or VPN.
# Set this only if the server is publicly reachable and you need access control.
# Format: comma-separated keys, one per engineer.
# API_KEYS=key-alice,key-bob,key-carol
API_KEYS=

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://backyard:backyard@localhost:5432/backyard

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Anthropic ─────────────────────────────────────────────────────────────────
# Used for file summary generation and activity log compression.
ANTHROPIC_API_KEY=sk-ant-...

# ── Server ────────────────────────────────────────────────────────────────────
# Public base URL of this deployment (used in dashboard links and MCP config snippets)
BASE_URL=https://your-app.up.railway.app

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ── Enterprise (optional) ─────────────────────────────────────────────────────
# Leave blank for simple API key auth (Option 1 / Option 2).
# Fill in for SSO/SAML (Option 3 / Enterprise).

# SAML_IDP_METADATA_URL=https://your-idp.com/saml/metadata
# SAML_SP_ENTITY_ID=https://your-app.com
# SAML_SP_ACS_URL=https://your-app.com/auth/saml/callback

# ── Audit log retention (days; 0 = keep forever) ─────────────────────────────
AUDIT_RETENTION_DAYS=365
